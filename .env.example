# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Database ---------------------------------------------------------------
# Production: a hosted Turso database.
#   turso db create buyzo
#   turso db show buyzo --url
#   turso db tokens create buyzo
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local development instead: leave the two above empty and point at a file.
# Defaults to file:data/buyzo.db when nothing is set.
# DATABASE_URL=file:data/buyzo.db

# --- Admin sign-in (required — there is no built-in fallback) ---------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Salt for the admin session token. Changing it signs existing admins out.
SESSION_SECRET=

# --- Email (required in production) -----------------------------------------
# Sign-up sends a 6-digit verification code by email, so without a provider no
# customer can register. Demo mode (key unset) prints the code to the server
# console instead of mailing it — fine locally, not usable in production.
RESEND_API_KEY=
MAIL_FROM=Buyzo <onboarding@resend.dev>

# Salt for hashing OTP codes at rest. Changing it invalidates codes in flight.
OTP_SECRET=
